# Local development only. Never commit real credentials.
APP_NAME="PaisaDiary API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://paisadiary:paisadiary@localhost:5432/paisadiary"

# Generate a strong random secret for production; never use this example value.
JWT_SECRET_KEY="local-development-only-change-this-secret"
JWT_ALGORITHM="HS256"
